//@version=6
indicator("Liquidity Pro [BSL • SSL • Reversals]", "LiqPro", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500, max_bars_back = 5000)

// ═════════════════════════════ INPUTS ═════════════════════════════
grpL = "Liquidity Pools"
swingLen  = input.int(20, "Swing Length", minval = 2, group = grpL, tooltip = "Pivot üçün sol/sağ bar sayı")
volLen    = input.int(20, "Volume Average Length", minval = 1, group = grpL)
minRatio  = input.float(1.0, "Min Volume Ratio", minval = 0.0, step = 0.1, group = grpL, tooltip = "Pivot pəncərəsinin həcmi / orta həcm. Aşağıda olan pivotlar nəzərə alınmır")
lookbackH = input.float(48, "Lookback Period (Hours)", minval = 1, group = grpL)
useWin    = input.bool(true, "Use Price Window Filter", group = grpL)
winPts    = input.float(500, "Liquidity Window (Points per Side)", minval = 0, group = grpL)
maxPools  = input.int(30, "Max Active Pools per Side", minval = 1, maxval = 100, group = grpL)
eqTolAtr  = input.float(0.10, "Equal High/Low Tolerance (ATR)", minval = 0, step = 0.05, group = grpL, tooltip = "Yaxın pivotlar EQH/EQL kimi birləşir — ən güclü likvidlik")
minStars  = input.int(2, "Min Strength to Show (1-5)", minval = 1, maxval = 5, group = grpL, tooltip = "Zəif pool-ları gizlədir. 1 = hamısı, 3+ = yalnız güclülər")

grpK = "Key Levels"
useDay  = input.bool(true, "Previous Day High / Low (PDH/PDL)", group = grpK)
useWeek = input.bool(true, "Previous Week High / Low (PWH/PWL)", group = grpK)
useAsia = input.bool(true, "Asia Session High / Low", group = grpK)
asiaSes = input.session("2000-0000", "Asia Session (New York time)", group = grpK)

grpR = "Reversal Engine"
showZone  = input.bool(true, "Show Reversal Zones", group = grpR, tooltip = "Hər güclü pool-un arxasındakı stop-hunt zonası — qiymət bura girib geri dönərsə reversal ehtimalı yüksəkdir")
zoneAtr   = input.float(0.5, "Zone Depth (ATR)", minval = 0.1, step = 0.1, group = grpR)
mssLen    = input.int(3, "Structure Shift Pivot Length", minval = 1, maxval = 10, group = grpR, tooltip = "Sweep-dən sonra təsdiq üçün kiçik struktur (MSS) pivotu")
confBars  = input.int(20, "Max Bars to Confirm", minval = 1, group = grpR)
minScore  = input.int(3, "Min Signal Score (1-5)", minval = 1, maxval = 5, group = grpR)
showTrade = input.bool(true, "Draw Entry / SL / TP", group = grpR)
tradeBars = input.int(30, "Trade Lines Length (bars)", minval = 5, group = grpR)

grpS = "Style"
showLines = input.bool(true, "Liquidity Lines", group = grpS)
showBub   = input.bool(true, "Volume Bubbles at Pivot", group = grpS)
showTag   = input.bool(true, "Labels (type • price • volume • ★)", group = grpS)
keepSwept = input.bool(true, "Keep Swept Levels", group = grpS)
sweptKeep = input.int(40, "Swept Level Lifetime (bars)", minval = 1, group = grpS)
cBsl      = input.color(#f23645, "Buy-side (above)", group = grpS)
cSsl      = input.color(#2962ff, "Sell-side (below)", group = grpS)
cSwept    = input.color(#787b86, "Swept", group = grpS)
cBull     = input.color(#00c853, "Bullish Reversal", group = grpS)
cBear     = input.color(#ff1744, "Bearish Reversal", group = grpS)

grpT = "Dashboard"
showTbl = input.bool(true, "Show Dashboard", group = grpT)
tblPos  = input.string("Top Right", "Position", options = ["Top Right", "Bottom Right", "Top Left", "Bottom Left"], group = grpT)

// ═════════════════════════════ TYPES / HELPERS ═════════════════════════════
type Pool
    float  price
    int    bar
    int    t
    float  vol
    float  ratio
    int    touches
    bool   isHigh
    string kind     = ""
    bool   swept    = false
    int    sweptAt  = na
    line   ln
    label  bub
    label  txt
    box    zone

fmtVol(float v) =>
    v >= 1e9 ? str.tostring(v / 1e9, "#.##") + "B" : v >= 1e6 ? str.tostring(v / 1e6, "#.##") + "M" : v >= 1e3 ? str.tostring(v / 1e3, "#") + "K" : str.tostring(v, "#")

stars(Pool p) =>
    int s = 1
    s += p.ratio >= 1.5 ? 1 : 0
    s += p.ratio >= 2.5 ? 1 : 0
    s += p.touches >= 2 ? 1 : 0
    s += p.touches >= 3 or p.kind != "" ? 1 : 0
    math.min(5, p.kind != "" ? math.max(s, 4) : s)

starStr(int n) =>
    str.repeat("★", n)

tagOf(Pool p) =>
    p.kind != "" ? p.kind : p.isHigh ? (p.touches > 1 ? "EQH×" + str.tostring(p.touches) : "BSL") : (p.touches > 1 ? "EQL×" + str.tostring(p.touches) : "SSL")

lineText(Pool p) =>
    showTag ? tagOf(p) + "  " + str.tostring(p.price, format.mintick) + (p.vol > 0 ? "  " + fmtVol(p.vol) : "") + "  " + starStr(stars(p)) : ""

bubSize(float r) =>
    r < 1.0 ? size.tiny : r < 1.6 ? size.small : r < 2.5 ? size.normal : size.large

deletePool(Pool p) =>
    line.delete(p.ln)
    label.delete(p.bub)
    label.delete(p.txt)
    box.delete(p.zone)

// ═════════════════════════════ CORE ═════════════════════════════
var array<Pool> highs = array.new<Pool>()
var array<Pool> lows  = array.new<Pool>()

atr    = ta.atr(14)
win    = 2 * swingLen + 1
winVol = math.sum(nz(volume), win)
avgVol = ta.sma(nz(volume), volLen) * win
ph     = ta.pivothigh(high, swingLen, swingLen)
pl     = ta.pivotlow(low, swingLen, swingLen)
lbMs   = lookbackH * 3600000.0

newPool(float price, bool isHigh, int pb, int pt, float v, float r, string kind) =>
    col = isHigh ? cBsl : cSsl
    Pool p = Pool.new(price, pb, pt, v, r, 1, isHigh, kind)
    if showLines
        p.ln := line.new(pb, price, bar_index, price, color = col, width = kind != "" ? 2 : 1, style = kind != "" ? line.style_solid : line.style_solid)
    if showBub and kind == ""
        p.bub := label.new(pb, price, "", style = label.style_circle, color = color.new(col, 30), size = bubSize(r), tooltip = "Volume: " + fmtVol(v) + "\nRatio: " + str.tostring(r, "#.##") + "x")
    p.txt := label.new(bar_index, price, lineText(p), style = label.style_none, textcolor = col, size = size.small, textalign = text.align_left)
    if showZone
        float z = zoneAtr * atr
        p.zone := box.new(pb, isHigh ? price + z : price, bar_index, isHigh ? price : price - z, border_color = color.new(col, 100), bgcolor = color.new(col, 88))
    p

push(array<Pool> arr, Pool p) =>
    arr.push(p)
    if arr.size() > maxPools
        deletePool(arr.shift())

addPivot(array<Pool> arr, float price, bool isHigh) =>
    float r   = avgVol > 0 ? winVol / avgVol : 1.0
    float tol = eqTolAtr * atr
    if r >= minRatio
        bool merged = false
        if arr.size() > 0
            for p in arr
                if not p.swept and p.kind == "" and math.abs(p.price - price) <= tol
                    p.price   := isHigh ? math.max(p.price, price) : math.min(p.price, price)
                    p.vol     += winVol
                    p.ratio   := math.max(p.ratio, r)
                    p.touches += 1
                    line.set_y1(p.ln, p.price)
                    line.set_y2(p.ln, p.price)
                    label.set_y(p.bub, p.price)
                    merged := true
                    break
        if not merged
            push(arr, newPool(price, isHigh, bar_index - swingLen, time[swingLen], winVol, r, ""))

if not na(ph)
    addPivot(highs, ph, true)
if not na(pl)
    addPivot(lows, pl, false)

// ── Key levels ──
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[pwh, pwl] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)
newDay  = timeframe.change("D")
newWeek = timeframe.change("W")
if useDay and newDay and not timeframe.isdwm
    push(highs, newPool(pdh, true, bar_index, time, 0, 0, "PDH"))
    push(lows, newPool(pdl, false, bar_index, time, 0, 0, "PDL"))
if useWeek and newWeek and not timeframe.isweekly and not timeframe.ismonthly
    push(highs, newPool(pwh, true, bar_index, time, 0, 0, "PWH"))
    push(lows, newPool(pwl, false, bar_index, time, 0, 0, "PWL"))

inAsia = not na(time(timeframe.period, asiaSes, "America/New_York"))
var float aHi = na
var float aLo = na
var int   aHb = na
var int   aLb = na
if useAsia and timeframe.isintraday
    if inAsia and not inAsia[1]
        aHi := high
        aLo := low
        aHb := bar_index
        aLb := bar_index
    else if inAsia
        if high > aHi
            aHi := high
            aHb := bar_index
        if low < aLo
            aLo := low
            aLb := bar_index
    if not inAsia and inAsia[1] and not na(aHi)
        push(highs, newPool(aHi, true, aHb, time[bar_index - aHb], 0, 0, "ASIA H"))
        push(lows, newPool(aLo, false, aLb, time[bar_index - aLb], 0, 0, "ASIA L"))

// ── Minor structure for MSS confirmation ──
mph = ta.pivothigh(high, mssLen, mssLen)
mpl = ta.pivotlow(low, mssLen, mssLen)
var float minorHi = na
var float minorLo = na
if not na(mph)
    minorHi := mph
if not na(mpl)
    minorLo := mpl

// ── Sweep detection ──
var int   pendDir   = 0       // -1 BSL raid → bearish gözlənilir, +1 SSL raid → bullish
var int   pendBar   = na
var float pendExt   = na
var float pendLvl   = na
var float pendMss   = na
var int   pendStars = 0
var string pendTag  = ""
bool raidBsl = false
bool raidSsl = false

// Funksiya qlobal dəyişəni dəyişə bilmir → ən güclü raid-i qaytarır
updatePools(array<Pool> arr) =>
    int    rStars = 0
    float  rExt   = na
    float  rLvl   = na
    string rTag   = ""
    if arr.size() > 0
        for i = arr.size() - 1 to 0
            Pool p = arr.get(i)
            bool remove = false
            int  st = stars(p)
            if not p.swept
                bool took = p.isHigh ? high > p.price : low < p.price
                if took and bar_index > p.bar
                    p.swept   := true
                    p.sweptAt := bar_index
                    bool rejected = p.isHigh ? close < p.price : close > p.price
                    line.set_x2(p.ln, bar_index)
                    line.set_color(p.ln, cSwept)
                    line.set_style(p.ln, line.style_dashed)
                    label.set_color(p.bub, color.new(cSwept, 60))
                    label.set_textcolor(p.txt, cSwept)
                    label.set_x(p.txt, bar_index)
                    label.set_text(p.txt, showTag ? (rejected ? "RAID " : "BREAK ") + tagOf(p) : "")
                    box.delete(p.zone)
                    if rejected and st > rStars
                        rStars := st
                        rExt   := p.isHigh ? high : low
                        rLvl   := p.price
                        rTag   := tagOf(p)
                    if not keepSwept
                        remove := true
                else
                    bool vis = st >= minStars and (not useWin or math.abs(p.price - close) <= winPts)
                    color c = p.isHigh ? cBsl : cSsl
                    line.set_x2(p.ln, bar_index + 5)
                    line.set_color(p.ln, vis ? color.new(c, st >= 4 ? 0 : 35) : color.new(c, 100))
                    line.set_width(p.ln, st >= 4 ? 2 : 1)
                    label.set_x(p.txt, bar_index + 5)
                    label.set_text(p.txt, lineText(p))
                    label.set_textcolor(p.txt, vis ? c : color.new(c, 100))
                    label.set_color(p.bub, vis ? color.new(c, 30) : color.new(c, 100))
                    box.set_right(p.zone, bar_index + 5)
                    box.set_bgcolor(p.zone, vis and st >= 3 ? color.new(c, 85) : color.new(c, 100))
            else if bar_index - p.sweptAt > sweptKeep
                remove := true
            if time - p.t > lbMs and p.kind == "" or p.kind != "" and time - p.t > 8 * 86400000
                remove := true
            if remove
                deletePool(p)
                arr.remove(i)
    [rStars, rExt, rLvl, rTag]

[hS, hExt, hLvl, hTag] = updatePools(highs)
[lS, lExt, lLvl, lTag] = updatePools(lows)
raidBsl := hS > 0 and hS >= lS
raidSsl := lS > 0 and lS > hS
// yeni raid köhnə gözləməni əvəz edir (daha güclü və ya köhnəsi bitib)
if (raidBsl or raidSsl) and (pendDir == 0 or math.max(hS, lS) >= pendStars or bar_index - pendBar > confBars)
    pendDir   := raidBsl ? -1 : 1
    pendBar   := bar_index
    pendExt   := raidBsl ? hExt : lExt
    pendLvl   := raidBsl ? hLvl : lLvl
    pendMss   := raidBsl ? minorLo : minorHi
    pendStars := math.max(hS, lS)
    pendTag   := raidBsl ? hTag : lTag
if raidBsl
    label.new(bar_index, high, "⚠", style = label.style_label_down, color = color.new(color.white, 100), textcolor = cBear, size = size.small, tooltip = "BSL raid: " + pendTag + " — MSS təsdiqi gözlənilir")
if raidSsl
    label.new(bar_index, low, "⚠", style = label.style_label_up, color = color.new(color.white, 100), textcolor = cBull, size = size.small, tooltip = "SSL raid: " + pendTag + " — MSS təsdiqi gözlənilir")

// ═════════════════════════════ REVERSAL CONFIRMATION ═════════════════════════════
nearest(array<Pool> arr, bool above) =>
    Pool best = na
    for p in arr
        if not p.swept and (above ? p.price > close : p.price < close) and (na(best) or math.abs(p.price - close) < math.abs(best.price - close))
            best := p
    best

bool bullSig = false
bool bearSig = false
var string lastSig = "—"
volSpike = nz(volume) > 1.5 * ta.sma(nz(volume), volLen)

if pendDir != 0
    if bar_index - pendBar > confBars
        pendDir := 0
    else
        // sweep ekstremumu yenilənirsə, onu izlə (stop yeri)
        if pendDir == -1 and high > pendExt
            pendExt := high
        if pendDir == 1 and low < pendExt
            pendExt := low
        bool invalid = pendDir == -1 ? close > pendExt : close < pendExt
        bool mss = pendDir == -1 ? not na(pendMss) and close < pendMss : not na(pendMss) and close > pendMss
        if invalid
            pendDir := 0
        else if mss
            float body  = math.abs(close - open)
            bool  disp  = body > 0.8 * atr                 // displacement şamı
            int   score = math.min(5, math.max(1, pendStars - 1) + (disp ? 1 : 0) + (volSpike ? 1 : 0))
            if score >= minScore
                bool  bull  = pendDir == 1
                Pool  tgtP  = bull ? nearest(highs, true) : nearest(lows, false)
                float sl    = pendExt
                float tp    = na(tgtP) ? (bull ? close + 2 * math.abs(close - sl) : close - 2 * math.abs(close - sl)) : tgtP.price
                float rr    = math.abs(tp - close) / math.max(syminfo.mintick, math.abs(close - sl))
                color c     = bull ? cBull : cBear
                string txt  = (bull ? "▲ BUY" : "▼ SELL") + "  " + starStr(score) + "\n" + pendTag + " sweep + MSS"
                label.new(bar_index, bull ? low : high, txt, style = bull ? label.style_label_up : label.style_label_down, color = c, textcolor = color.white, size = size.small, tooltip = "Entry: " + str.tostring(close, format.mintick) + "\nSL: " + str.tostring(sl, format.mintick) + "\nTP: " + str.tostring(tp, format.mintick) + (na(tgtP) ? " (2R)" : " (" + tagOf(tgtP) + ")") + "\nRR: " + str.tostring(rr, "#.##") + "\nDisplacement: " + (disp ? "✔" : "✘") + "  Volume: " + (volSpike ? "✔" : "✘"))
                if showTrade
                    line.new(bar_index, close, bar_index + tradeBars, close, color = color.new(color.gray, 0), width = 1)
                    line.new(bar_index, sl, bar_index + tradeBars, sl, color = cBear, style = line.style_dashed)
                    line.new(bar_index, tp, bar_index + tradeBars, tp, color = cBull, style = line.style_dashed)
                    box.new(bar_index, math.max(close, sl), bar_index + tradeBars, math.min(close, sl), border_color = color.new(cBear, 100), bgcolor = color.new(cBear, 90))
                    box.new(bar_index, math.max(close, tp), bar_index + tradeBars, math.min(close, tp), border_color = color.new(cBull, 100), bgcolor = color.new(cBull, 90))
                    label.new(bar_index + tradeBars, tp, "TP " + str.tostring(tp, format.mintick) + "  RR " + str.tostring(rr, "#.#"), style = label.style_none, textcolor = cBull, size = size.small, textalign = text.align_left)
                bullSig := bull
                bearSig := not bull
                lastSig := (bull ? "▲ BUY " : "▼ SELL ") + str.tostring(close, format.mintick) + "  " + starStr(score)
            pendDir := 0

// ═════════════════════════════ DASHBOARD ═════════════════════════════
pos = tblPos == "Top Right" ? position.top_right : tblPos == "Bottom Right" ? position.bottom_right : tblPos == "Top Left" ? position.top_left : position.bottom_left
var table tbl = table.new(pos, 4, 6, bgcolor = color.new(#131722, 5), border_width = 1, border_color = color.new(#363a45, 0))
rowF(int r, string name, Pool p, color c) =>
    table.cell(tbl, 0, r, name, text_color = c, text_size = size.small, text_halign = text.align_left)
    table.cell(tbl, 1, r, na(p) ? "—" : tagOf(p) + " " + str.tostring(p.price, format.mintick), text_color = color.white, text_size = size.small)
    table.cell(tbl, 2, r, na(p) ? "—" : str.tostring(math.abs(p.price - close), format.mintick), text_color = color.white, text_size = size.small)
    table.cell(tbl, 3, r, na(p) ? "—" : starStr(stars(p)), text_color = color.yellow, text_size = size.small)

if showTbl and barstate.islast
    tc = color.white
    ts = size.small
    Pool nb = nearest(highs, true)
    Pool ns = nearest(lows, false)
    // ən güclü (magnit) hədəf hər tərəfdə
    Pool sb = na
    Pool ss = na
    for p in highs
        if not p.swept and p.price > close and (na(sb) or stars(p) > stars(sb) or stars(p) == stars(sb) and p.price < sb.price)
            sb := p
    for p in lows
        if not p.swept and p.price < close and (na(ss) or stars(p) > stars(ss) or stars(p) == stars(ss) and p.price > ss.price)
            ss := p
    table.cell(tbl, 0, 0, "", text_color = tc, text_size = ts)
    table.cell(tbl, 1, 0, "Level", text_color = tc, text_size = ts)
    table.cell(tbl, 2, 0, "Dist", text_color = tc, text_size = ts)
    table.cell(tbl, 3, 0, "Strength", text_color = tc, text_size = ts)
    rowF(1, "Next BSL ▲", nb, cBsl)
    rowF(2, "Major BSL ▲", sb, cBsl)
    rowF(3, "Next SSL ▼", ns, cSsl)
    rowF(4, "Major SSL ▼", ss, cSsl)
    string st = pendDir == -1 ? "BSL raided → SELL MSS gözlənilir" : pendDir == 1 ? "SSL raided → BUY MSS gözlənilir" : "Son siqnal: " + lastSig
    table.cell(tbl, 0, 5, st, text_color = pendDir == -1 ? cBear : pendDir == 1 ? cBull : tc, text_size = ts)
    table.merge_cells(tbl, 0, 5, 3, 5)

// ═════════════════════════════ ALERTS ═════════════════════════════
alertcondition(raidBsl, "BSL Raid", "{{ticker}}: buy-side liquidity raided — bearish reversal watch")
alertcondition(raidSsl, "SSL Raid", "{{ticker}}: sell-side liquidity raided — bullish reversal watch")
alertcondition(bullSig, "Bullish Reversal", "{{ticker}}: SSL sweep + MSS → BUY @ {{close}}")
alertcondition(bearSig, "Bearish Reversal", "{{ticker}}: BSL sweep + MSS → SELL @ {{close}}")
if bullSig or bearSig
    alert(syminfo.ticker + " " + lastSig, alert.freq_once_per_bar_close)
