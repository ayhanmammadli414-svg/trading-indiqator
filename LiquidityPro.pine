//@version=6
indicator("Liquidity Pro [Pools • Sweeps • Heatmap]", "LiqPro", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500, max_bars_back = 5000)

// ═════════════════════════════ INPUTS ═════════════════════════════
grpL = "Liquidity"
swingLen  = input.int(20, "Swing Length", minval = 2, group = grpL, tooltip = "Pivot üçün sol/sağ bar sayı")
volLen    = input.int(20, "Volume Average Length", minval = 1, group = grpL)
minRatio  = input.float(1.0, "Min Volume Ratio", minval = 0.0, step = 0.1, group = grpL, tooltip = "Pivot pəncərəsinin həcmi / orta həcm. 1.0 = orta, 1.5 = güclü pool-lar")
lookbackH = input.float(48, "Lookback Period (Hours)", minval = 1, group = grpL)
useWin    = input.bool(true, "Use Price Window Filter", group = grpL)
winPts    = input.float(500, "Liquidity Window (Points per Side)", minval = 0, group = grpL)
maxPools  = input.int(40, "Max Active Pools per Side", minval = 1, maxval = 120, group = grpL)
eqTolAtr  = input.float(0.10, "Equal High/Low Tolerance (ATR)", minval = 0, step = 0.05, group = grpL, tooltip = "Yaxın pivotlar EQH/EQL kimi birləşir, həcmi toplanır")
sweepMode = input.string("Wick", "Sweep Mode", options = ["Wick", "Close"], group = grpL, tooltip = "Wick: fitil keçən kimi süpürülür. Close: bağlanış lazımdır")
keepSwept = input.bool(true, "Keep Swept Levels", group = grpL)
sweptKeep = input.int(60, "Swept Level Lifetime (bars)", minval = 1, group = grpL)

grpS = "Style"
showBub   = input.bool(true, "Volume Bubbles", group = grpS)
showVolT  = input.bool(true, "Volume Text (K/M)", group = grpS)
showLines = input.bool(true, "Liquidity Lines", group = grpS)
showTag   = input.bool(true, "BSL/SSL/EQH/EQL Tags", group = grpS)
showRaid  = input.bool(true, "Sweep Markers", group = grpS)
cBsl      = input.color(color.new(#f23645, 0), "Buy-side (Highs)", group = grpS)
cSsl      = input.color(color.new(#2962ff, 0), "Sell-side (Lows)", group = grpS)
cSwept    = input.color(color.new(#787b86, 0), "Swept", group = grpS)
lineW     = input.int(1, "Line Width", minval = 1, maxval = 4, group = grpS)

grpH = "Heatmap"
showHeat  = input.bool(true, "Show Heatmap", group = grpH)
heatSrc   = input.string("Pools + Volume", "Heatmap Source", options = ["Pools", "Volume", "Pools + Volume"], group = grpH)
bins      = input.int(50, "Number of Heatmap Bins", minval = 5, maxval = 150, group = grpH)
heatW     = input.int(40, "Heatmap Max Width (bars)", minval = 5, group = grpH)
heatOff   = input.int(8, "Heatmap Offset (bars)", minval = 0, group = grpH)
cHeat     = input.color(#ff9800, "Heat Color", group = grpH)

grpT = "Dashboard"
showTbl   = input.bool(true, "Show Nearest Liquidity Table", group = grpT)
tblPos    = input.string("Top Right", "Position", options = ["Top Right", "Bottom Right", "Top Left", "Bottom Left"], group = grpT)

// ═════════════════════════════ TYPES / HELPERS ═════════════════════════════
type Pool
    float price
    int   bar
    int   t
    float vol
    float ratio
    int   touches
    bool  isHigh
    bool  swept   = false
    int   sweptAt = na
    line  ln
    label bub
    label txt

fmtVol(float v) =>
    v >= 1e9 ? str.tostring(v / 1e9, "#.##") + "B" : v >= 1e6 ? str.tostring(v / 1e6, "#.##") + "M" : v >= 1e3 ? str.tostring(v / 1e3, "#") + "K" : str.tostring(v, "#")

bubSize(float r) =>
    r < 1.0 ? size.small : r < 1.6 ? size.normal : r < 2.5 ? size.large : size.huge

tagOf(Pool p) =>
    (p.isHigh ? (p.touches > 1 ? "EQH" : "BSL") : (p.touches > 1 ? "EQL" : "SSL")) + (p.touches > 1 ? " ×" + str.tostring(p.touches) : "")

lineText(Pool p) =>
    showTag ? tagOf(p) + "  " + str.tostring(p.price, format.mintick) + (showVolT ? "  " + fmtVol(p.vol) : "") : ""

deletePool(Pool p) =>
    line.delete(p.ln)
    label.delete(p.bub)
    label.delete(p.txt)

// ═════════════════════════════ CORE CALC ═════════════════════════════
var array<Pool> highs = array.new<Pool>()
var array<Pool> lows  = array.new<Pool>()

atr     = ta.atr(14)
win     = 2 * swingLen + 1
winVol  = math.sum(nz(volume), win)                    // pivot ± swingLen pəncərəsinin həcmi
avgVol  = ta.sma(nz(volume), volLen) * win
ph      = ta.pivothigh(high, swingLen, swingLen)
pl      = ta.pivotlow(low, swingLen, swingLen)
lbMs    = lookbackH * 3600000.0

createPool(float price, bool isHigh, float v, float r) =>
    int  pb  = bar_index - swingLen
    col      = isHigh ? cBsl : cSsl
    Pool p   = Pool.new(price, pb, time[swingLen], v, r, 1, isHigh)
    if showLines
        p.ln := line.new(pb, price, bar_index, price, color = col, width = lineW)
    if showBub
        p.bub := label.new(pb, price, "", style = label.style_circle, color = color.new(col, 25), size = bubSize(r))
    p.txt := label.new(bar_index, price, lineText(p), style = label.style_none, textcolor = col, size = size.small, textalign = text.align_left)
    if showVolT and showBub
        label.set_tooltip(p.bub, tagOf(p) + "\nPrice: " + str.tostring(price, format.mintick) + "\nVolume: " + fmtVol(v) + "\nRatio: " + str.tostring(r, "#.##") + "x")
    p

addPivot(array<Pool> arr, float price, bool isHigh) =>
    float r   = avgVol > 0 ? winVol / avgVol : 1.0
    float tol = eqTolAtr * atr
    if r >= minRatio
        bool merged = false
        if arr.size() > 0
            for p in arr
                if not p.swept and math.abs(p.price - price) <= tol
                    p.price   := isHigh ? math.max(p.price, price) : math.min(p.price, price)
                    p.vol     += winVol
                    p.ratio   := math.max(p.ratio, r)
                    p.touches += 1
                    label.set_y(p.bub, p.price)
                    label.set_size(p.bub, bubSize(p.ratio + 0.5 * (p.touches - 1)))
                    line.set_y1(p.ln, p.price)
                    line.set_y2(p.ln, p.price)
                    merged := true
                    break
        if not merged
            arr.push(createPool(price, isHigh, winVol, r))
            if arr.size() > maxPools
                deletePool(arr.shift())

if not na(ph)
    addPivot(highs, ph, true)
if not na(pl)
    addPivot(lows, pl, false)

// Update: sweep / extend / expire / window
var int   sweptHiCount = 0
var int   sweptLoCount = 0
bool bslSwept = false
bool sslSwept = false
float lastSweepPx = na

updatePools(array<Pool> arr) =>
    bool hit = false
    float px = na
    if arr.size() > 0
        for i = arr.size() - 1 to 0
            Pool p = arr.get(i)
            bool remove = false
            if not p.swept
                bool took = p.isHigh ? (sweepMode == "Wick" ? high > p.price : close > p.price) : (sweepMode == "Wick" ? low < p.price : close < p.price)
                if took and bar_index > p.bar + swingLen
                    p.swept   := true
                    p.sweptAt := bar_index
                    hit := true
                    px  := p.price
                    bool rejected = p.isHigh ? close < p.price : close > p.price
                    line.set_x2(p.ln, bar_index)
                    line.set_color(p.ln, cSwept)
                    line.set_style(p.ln, line.style_dashed)
                    label.set_color(p.bub, color.new(cSwept, 50))
                    label.set_textcolor(p.txt, cSwept)
                    label.set_x(p.txt, bar_index)
                    label.set_text(p.txt, showTag ? (rejected ? "✕ RAID " : "✕ BREAK ") + tagOf(p) : "")
                    if showRaid
                        label.new(bar_index, p.price, rejected ? "⚡" : "", style = p.isHigh ? label.style_label_down : label.style_label_up, color = color.new(color.white, 100), textcolor = p.isHigh ? cBsl : cSsl, size = size.small)
                    if not keepSwept
                        remove := true
                else
                    line.set_x2(p.ln, bar_index + 3)
                    label.set_x(p.txt, bar_index + 3)
                    bool inWin = not useWin or math.abs(p.price - close) <= winPts
                    color c = p.isHigh ? cBsl : cSsl
                    line.set_color(p.ln, inWin ? c : color.new(c, 100))
                    label.set_textcolor(p.txt, inWin ? c : color.new(c, 100))
                    label.set_color(p.bub, inWin ? color.new(c, 25) : color.new(c, 100))
                    label.set_text(p.txt, lineText(p))
            else if bar_index - p.sweptAt > sweptKeep
                remove := true
            if time - p.t > lbMs
                remove := true
            if remove
                deletePool(p)
                arr.remove(i)
    [hit, px]

[hHit, hPx] = updatePools(highs)
[lHit, lPx] = updatePools(lows)
bslSwept := hHit
sslSwept := lHit

// ═════════════════════════════ HEATMAP ═════════════════════════════
var array<box> heat = array.new<box>()
if showHeat and barstate.islast
    for b in heat
        box.delete(b)
    heat.clear()
    float top = useWin ? close + winPts : na
    float bot = useWin ? close - winPts : na
    if not useWin
        top := high
        bot := low
        for p in highs
            top := math.max(top, p.price)
        for p in lows
            bot := math.min(bot, p.price)
    float step = (top - bot) / bins
    if step > 0
        array<float> w = array.new<float>(bins, 0.0)
        if heatSrc != "Volume"
            for p in highs
                if not p.swept and p.price >= bot and p.price <= top
                    int k = math.min(bins - 1, int((p.price - bot) / step))
                    w.set(k, w.get(k) + p.vol)
            for p in lows
                if not p.swept and p.price >= bot and p.price <= top
                    int k = math.min(bins - 1, int((p.price - bot) / step))
                    w.set(k, w.get(k) + p.vol)
        if heatSrc != "Pools"
            int tfSec = timeframe.in_seconds()
            int n = math.min(4999, math.max(1, int(lookbackH * 3600 / tfSec)), bar_index)
            for j = 0 to n - 1
                float hp = hlc3[j]
                if hp >= bot and hp <= top
                    int k = math.min(bins - 1, int((hp - bot) / step))
                    w.set(k, w.get(k) + nz(volume[j]))
        float mx = w.max()
        if mx > 0
            for k = 0 to bins - 1
                float v = w.get(k)
                if v > 0
                    int len = math.max(1, int(heatW * v / mx))
                    color c = color.from_gradient(v, 0, mx, color.new(cHeat, 92), color.new(cHeat, 15))
                    heat.push(box.new(bar_index + heatOff, bot + step * (k + 1), bar_index + heatOff + len, bot + step * k, border_color = color.new(cHeat, 100), bgcolor = c))

// ═════════════════════════════ DASHBOARD ═════════════════════════════
pos = tblPos == "Top Right" ? position.top_right : tblPos == "Bottom Right" ? position.bottom_right : tblPos == "Top Left" ? position.top_left : position.bottom_left
var table tbl = table.new(pos, 4, 4, bgcolor = color.new(#131722, 10), border_width = 1, border_color = color.new(#363a45, 0))
if showTbl and barstate.islast
    Pool nb = na
    Pool ns = na
    for p in highs
        if not p.swept and p.price > close and (na(nb) or p.price < nb.price)
            nb := p
    for p in lows
        if not p.swept and p.price < close and (na(ns) or p.price > ns.price)
            ns := p
    float totB = 0.0
    float totS = 0.0
    for p in highs
        totB += p.swept ? 0 : p.vol
    for p in lows
        totS += p.swept ? 0 : p.vol
    tc = color.white
    table.cell(tbl, 0, 0, "Side", text_color = tc, text_size = size.small)
    table.cell(tbl, 1, 0, "Level", text_color = tc, text_size = size.small)
    table.cell(tbl, 2, 0, "Dist", text_color = tc, text_size = size.small)
    table.cell(tbl, 3, 0, "Vol", text_color = tc, text_size = size.small)
    table.cell(tbl, 0, 1, "BSL ▲", text_color = cBsl, text_size = size.small)
    table.cell(tbl, 1, 1, na(nb) ? "—" : str.tostring(nb.price, format.mintick), text_color = tc, text_size = size.small)
    table.cell(tbl, 2, 1, na(nb) ? "—" : str.tostring(nb.price - close, format.mintick), text_color = tc, text_size = size.small)
    table.cell(tbl, 3, 1, na(nb) ? "—" : fmtVol(nb.vol), text_color = tc, text_size = size.small)
    table.cell(tbl, 0, 2, "SSL ▼", text_color = cSsl, text_size = size.small)
    table.cell(tbl, 1, 2, na(ns) ? "—" : str.tostring(ns.price, format.mintick), text_color = tc, text_size = size.small)
    table.cell(tbl, 2, 2, na(ns) ? "—" : str.tostring(close - ns.price, format.mintick), text_color = tc, text_size = size.small)
    table.cell(tbl, 3, 2, na(ns) ? "—" : fmtVol(ns.vol), text_color = tc, text_size = size.small)
    float tot = totB + totS
    string bias = tot == 0 ? "—" : totB > totS ? "Draw ▲ BSL " + str.tostring(100 * totB / tot, "#") + "%" : "Draw ▼ SSL " + str.tostring(100 * totS / tot, "#") + "%"
    table.cell(tbl, 0, 3, bias, text_color = totB > totS ? cBsl : cSsl, text_size = size.small)
    table.merge_cells(tbl, 0, 3, 3, 3)

// ═════════════════════════════ ALERTS ═════════════════════════════
alertcondition(bslSwept, "BSL Swept", "Buy-side liquidity swept on {{ticker}} @ {{close}}")
alertcondition(sslSwept, "SSL Swept", "Sell-side liquidity swept on {{ticker}} @ {{close}}")
if bslSwept
    alert("BSL swept " + syminfo.ticker + " @ " + str.tostring(hPx, format.mintick), alert.freq_once_per_bar)
if sslSwept
    alert("SSL swept " + syminfo.ticker + " @ " + str.tostring(lPx, format.mintick), alert.freq_once_per_bar)
